# Copy to .env and fill in.
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
OPENROUTER_API_KEY=sk-or-...

# Model ids from https://openrouter.ai/models (pick at checkpoint 1 from the baselines)
CHEAP_MODEL=meta-llama/llama-3.1-8b-instruct
MID_MODEL=openai/gpt-4o-mini
FRONTIER_MODEL=anthropic/claude-sonnet-4
AUTO_MODEL=openrouter/auto

# Databases
DATA_DB=sample_supplies
DATA_COLLECTION=sales
APP_DB=downshift
GATE_PASS_RATE=0.85
